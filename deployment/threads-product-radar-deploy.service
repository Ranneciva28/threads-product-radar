[Unit]
Description=Deploy Threads Product Radar from GitHub
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/threads-product-radar
Environment=APP_DIR=/opt/threads-product-radar
Environment=BRANCH=main
ExecStart=/opt/threads-product-radar/deployment/auto-deploy.sh

[Install]
WantedBy=multi-user.target

