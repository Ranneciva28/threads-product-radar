[Unit]
Description=Deploy Threads Product Radar from GitHub
After=network-online.target threads-product-radar.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=@APP_DIR@
Environment=APP_DIR=@APP_DIR@
Environment=APP_USER=@APP_USER@
Environment=BRANCH=main
Environment=SERVICE_NAME=threads-product-radar.service
ExecStart=@APP_DIR@/deployment/auto-deploy.sh

[Install]
WantedBy=multi-user.target
